# Copy to .env (never commit .env). All values optional in Phase 0.
# Path to the policy file. Defaults to config/policy.toml.
AICA_POLICY_FILE=config/policy.toml
# Directory for audit logs (JSONL). Defaults to .aica/audit
AICA_AUDIT_DIR=.aica/audit
# Model provider credentials are injected via environment only (SAFE-006).
# GLM_API_KEY=
# KIMI_API_KEY=
# DEEPSEEK_API_KEY=
# INT-004 Slack (Socket Mode). Read only by `aica slack`, via SEC-004 secrets in policy.toml.
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...
